{
  "title": "MATA — Watchdog Akuntabilitas Pengadaan",
  "uid": "mata-1",
  "tags": ["mata", "pbj"],
  "timezone": "Asia/Jakarta",
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pengumuman dipindai",
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "sqlite", "uid": "mata"},
      "targets": [
        {"refId": "A", "format": "table", "rawSql": "SELECT COUNT(*) FROM announcements"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total nilai pengadaan",
      "gridPos": {"h": 5, "w": 5, "x": 4, "y": 0},
      "datasource": {"type": "sqlite", "uid": "mata"},
      "targets": [
        {"refId": "A", "format": "table", "rawSql": "SELECT SUM(value) FROM announcements"}
      ],
      "fieldConfig": {"defaults": {"unit": "currencyIDR"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Siklus terakhir (status)",
      "gridPos": {"h": 5, "w": 4, "x": 9, "y": 0},
      "datasource": {"type": "sqlite", "uid": "mata"},
      "targets": [
        {"refId": "A", "format": "table", "rawSql": "SELECT status || ' @ ' || ts FROM runs ORDER BY id DESC LIMIT 1"}
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Indikasi per siklus (terakhir 12)",
      "gridPos": {"h": 5, "w": 7, "x": 13, "y": 0},
      "datasource": {"type": "sqlite", "uid": "mata"},
      "targets": [
        {"refId": "A", "format": "table", "rawSql": "SELECT n_flags, ts FROM runs ORDER BY id DESC LIMIT 12"}
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Nilai kontrak per bulan (jendela akhir tahun = red flag D3)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "sqlite", "uid": "mata"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT substr(date_signed,1,7) AS month, SUM(value)/1000000000.0 AS miliar FROM announcements GROUP BY month ORDER BY month"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "currencyIDR"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "table",
      "title": "Konsentrasi penyedia (D2)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "sqlite", "uid": "mata"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT vendor, COUNT(*) AS proyek, SUM(value)/1000000000.0 AS total_miliar, ROUND(100.0*SUM(value)/(SELECT SUM(value) FROM announcements),1) AS porsi_persen FROM announcements WHERE vendor IS NOT NULL GROUP BY vendor ORDER BY total_miliar DESC LIMIT 10"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Kontrak terbesar (konteks D1/D4)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13},
      "datasource": {"type": "sqlite", "uid": "mata"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT id, project, agency, vendor, date_signed, value, ref_price, source FROM announcements ORDER BY value DESC LIMIT 15"
        }
      ]
    }
  ]
}
